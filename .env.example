# ===== AI 漏洞解释（/ai/explain，DeepSeek）=====
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== AI 修复建议（/ai/suggest-fix，OpenRouter）=====
# API Key 仅从后端环境变量读取，绝不返回前端或写入日志。
OPENROUTER_API_KEY=
# 使用的模型，例如 openai/gpt-4o-mini
AI_MODEL=openai/gpt-4o-mini
# OpenRouter 基础地址（一般无需修改）
AI_BASE_URL=https://openrouter.ai/api/v1
# 单次请求超时（秒）
AI_REQUEST_TIMEOUT_SECONDS=30
# 模型最大输出 token 数
AI_MAX_OUTPUT_TOKENS=1200
# 发送给模型的代码片段最大字符数
AI_MAX_CODE_CHARS=4000
# 每个 client_id 每天最多非缓存调用次数
AI_DAILY_REQUEST_LIMIT=20
# 每个 client_id 每天累计费用上限（美元）
AI_DAILY_BUDGET_USD=1.0
